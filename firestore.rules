rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザーごとのデータ: 本人のみ読み書き可
    match /users/{userId}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // その他のドキュメントはすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
